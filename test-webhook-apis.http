### GitHub Webhook Testing

@baseUrl = http://localhost:8080/api
@webhookSecret = your_webhook_secret_here

###############################################
### WEBHOOK ENDPOINT TESTING
###############################################

### 1. Test Webhook Endpoint (GET)
# Verify the webhook endpoint is accessible
GET {{baseUrl}}/webhooks/github

###

### 2. Health Check
GET {{baseUrl}}/webhooks/health

###

###############################################
### SIMULATE GITHUB WEBHOOK EVENTS
###############################################

### 3. Pull Request Opened Event (Without Signature)
# This simulates a PR opened event
# Note: Signature validation will be skipped if webhook secret is not configured
POST {{baseUrl}}/webhooks/github
Content-Type: application/json
X-GitHub-Event: pull_request
X-GitHub-Delivery: 12345678-1234-1234-1234-123456789abc

{
  "action": "opened",
  "number": 1,
  "pull_request": {
    "id": 1234567890,
    "number": 1,
    "state": "open",
    "title": "Add new feature via webhook",
    "body": "This PR was created to test webhook integration",
    "user": {
      "id": 123456,
      "login": "testuser",
      "avatar_url": "https://avatars.githubusercontent.com/u/123456"
    },
    "html_url": "https://github.com/owner/repo/pull/1",
    "head": {
      "ref": "feature-branch",
      "sha": "abc123def456789"
    },
    "base": {
      "ref": "main",
      "sha": "def456abc123789"
    },
    "draft": false,
    "merged": false,
    "created_at": "2026-05-28T10:00:00Z",
    "updated_at": "2026-05-28T10:00:00Z"
  },
  "repository": {
    "id": 987654321,
    "name": "test-repo",
    "full_name": "testuser/test-repo",
    "owner": {
      "id": 123456,
      "login": "testuser"
    },
    "html_url": "https://github.com/testuser/test-repo"
  },
  "sender": {
    "id": 123456,
    "login": "testuser",
    "avatar_url": "https://avatars.githubusercontent.com/u/123456"
  }
}

