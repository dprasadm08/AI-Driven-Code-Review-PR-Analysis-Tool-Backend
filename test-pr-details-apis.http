###############################################
### FILE STATUS VALUES
###############################################

# Files can have the following status values:
# - "added": New file created in this PR
# - "modified": Existing file changed
# - "removed": File deleted in this PR
# - "renamed": File renamed/moved

###

###############################################
### UNDERSTANDING THE PATCH FORMAT
###############################################

# The "patch" field contains unified diff format:
# - Lines starting with "-" are deletions (removed lines)
# - Lines starting with "+" are additions (new lines)
# - Lines starting with " " (space) are context lines
# - @@ markers show line numbers: @@ -old_start,old_count +new_start,new_count @@

# Example patch:
# "@@ -10,7 +10,8 @@ public class MyClass {
#  
#      public void existingMethod() {
# -        // Old implementation
# +        // New improved implementation
# +        // Additional line
#          System.out.println(\"Hello\");
#      }
#  }"

###

###############################################
### USE CASES
###############################################

# 1. Code Review Dashboard:
#    - Fetch PR list: GET /pull-requests/repository/{repoId}
#    - Show PR summary
#    - On PR click, fetch details: GET /pull-requests/{id}/details
#    - Display files changed and commit history

# 2. AI Code Analysis:
#    - Fetch PR with diff: GET /pull-requests/{id}/details?includeDiff=true
#    - Parse the diff for AI analysis
#    - Analyze code changes for issues, best practices, etc.

# 3. Change Tracking:
#    - Fetch files to see what changed
#    - Track additions/deletions statistics
#    - Monitor file rename/move operations

# 4. Commit History:
#    - View all commits in the PR
#    - See commit messages and authors
#    - Link to GitHub for full commit details

###
