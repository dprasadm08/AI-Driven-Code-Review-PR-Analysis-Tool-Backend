### Webhook-Triggered Analysis Tests

@baseUrl = http://localhost:8080/api
@secret = ${GITHUB_WEBHOOK_SECRET:}

###############################################
### Webhook Health Check
###############################################

### 1. Test webhook endpoint is active
GET {{baseUrl}}/webhooks/github
Content-Type: application/json

###

### 2. Webhook health check
GET {{baseUrl}}/webhooks/health
Content-Type: application/json

###

###############################################
### Simulating GitHub Webhook Events
###############################################

### 3. Simulate PR opened event (triggers auto-analysis)
POST {{baseUrl}}/webhooks/github
Content-Type: application/json
X-GitHub-Event: pull_request
X-GitHub-Delivery: 12345-67890-abcdef
X-Hub-Signature-256: sha256=your_signature_here

{
  "action": "opened",
  "pull_request": {
    "id": 1296269,
    "number": 1,
    "state": "open",
    "title": "Amazing new feature",
    "description": "This PR includes amazing improvements",
    "draft": false,
    "merged": false,
    "user": {
      "login": "octocat",
      "avatar_url": "https://github.com/images/error/octocat_happy.gif"
    },
    "head": {
      "ref": "feature/awesome",
      "sha": "6dcb09b5b57875f3c8ea6c3d2b3a6c3c0e4e4e4e"
    },
    "base": {
      "ref": "main",
      "sha": "2b9b3a3a8c8c8c8c8c8c8c8c8c8c8c8c8c8c8c8c"
    }
  },
  "repository": {
    "id": 1296269,
    "name": "Hello-World",
    "full_name": "octocat/Hello-World"
  },
  "sender": {
    "login": "octocat"
  }
}

